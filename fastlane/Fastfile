default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Submit a new build to F-Droid (Verification only)"
  lane :fdroid_check do
    # This lane can be used to verify that metadata is correct
    # and the app builds correctly for F-Droid requirements
    gradle(task: "assembleRelease")
  end

  desc "Deploy a new version to the Google Play Store"
  lane :deploy do
    gradle(task: "clean assembleRelease")
    # upload_to_play_store # Uncomment and configure if needed in the future
  end
end
